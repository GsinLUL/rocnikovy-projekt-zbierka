@startuml
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 8
skinparam classFontSize 12
skinparam classFontName "Helvetica, Arial, sans-serif"

entity "users" as users {
  * id : UUID [PK]
  --
  * username : VARCHAR(50)
  * email : VARCHAR(255)
  * password_hash : VARCHAR(255)
  * role : VARCHAR(20)
  * currency : VARCHAR(3)
  * created_at : TIMESTAMP
}

entity "categories" as categories {
  * id : BIGINT [PK]
  --
  * name : VARCHAR(100)
  parent_id : BIGINT [FK]
  api_provider : VARCHAR(50)
}

entity "items" as items {
  * id : UUID [PK]
  --
  * user_id : UUID [FK]
  * category_id : BIGINT [FK]
  * name : VARCHAR(255)
  * condition : VARCHAR(50)
  * purchase_price : NUMERIC(10,2)
  * estimated_value : NUMERIC(10,2)
  * acquired_at : DATE
  external_api_id : VARCHAR(100)
  source_listing_id : BIGINT [FK]
  notes : TEXT
}

entity "price_history" as price_history {
  * id : BIGINT [PK]
  --
  * item_id : UUID [FK]
  * recorded_price : NUMERIC(10,2)
  * source : VARCHAR(50)
  * recorded_at : TIMESTAMP
}

entity "bot_filters" as bot_filters {
  * id : BIGINT [PK]
  --
  * user_id : UUID [FK]
  * keywords : VARCHAR(255)
  * max_price : NUMERIC(10,2)
  exclude_words : VARCHAR(255)
  * target_market : VARCHAR(50)
  * is_active : BOOLEAN
  * created_at : TIMESTAMP
}

entity "marketplace_listings" as listings {
  * id : BIGINT [PK]
  --
  * external_id : VARCHAR(100)
  * title : VARCHAR(255)
  * price : NUMERIC(10,2)
  * currency : VARCHAR(3)
  * listing_url : TEXT
  photo_url : TEXT
  * detected_at : TIMESTAMP
}

entity "notifications" as notifications {
  * id : BIGINT [PK]
  --
  * user_id : UUID [FK]
  * listing_id : BIGINT [FK]
  * status : VARCHAR(20)
  * sent_at : TIMESTAMP
  action_taken_at : TIMESTAMP
}

users ||--o{ items : "vlastní"
users ||--o{ bot_filters : "definuje pravidlá"
users ||--o{ notifications : "prijíma"

categories ||--o{ items : "klasifikuje"
categories ||--o{ categories : "nadradená"

items ||--o{ price_history : "má históriu cien"

bot_filters ||--o{ listings : "deteguje"
listings ||--o{ notifications : "spúšťa"
notifications |o..o| items : "automaticky vytvára"

@enduml
